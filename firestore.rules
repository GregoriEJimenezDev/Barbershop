rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isClient() {
      return isSignedIn() && getUserRole() == 'client';
    }

    // ============ USERS COLLECTION ============
    match /users/{userId} {
      // A user can read their own profile
      // Admins can read any user
      allow read: if isOwner(userId) || isAdmin();

      // A user can create their own document (during registration)
      // Role MUST default to 'client' - cannot self-assign admin
      allow create: if isOwner(userId)
        && request.resource.data.role == 'client'
        && request.resource.data.email is string
        && request.resource.data.name is string;

      // A user can update their own profile BUT cannot change role
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && (isAdmin() || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'updatedAt'])
        ));

      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ============ SERVICES COLLECTION (Price Board) ============
    match /services/{serviceId} {
      // Anyone (even unauthenticated) can read services for the public price board
      allow read: if true;

      // Only admins can create, update, or delete services
      allow create, update, delete: if isAdmin();

      // Validate service structure
      allow write: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes > 0;
    }

    // ============ AVAILABILITY COLLECTION ============
    match /availability/{dateId} {
      // Anyone can read availability (for booking flow)
      allow read: if true;

      // Only admins can create, update, or delete availability
      allow create, update, delete: if isAdmin();

      // Validate availability structure
      allow write: if isAdmin()
        && request.resource.data.date is string
        && request.resource.data.maxAppointments is number
        && request.resource.data.maxAppointments >= 0
        && request.resource.data.timeSlots is list
        && request.resource.data.blocked == false ||
           request.resource.data.blocked == true;
    }

    // ============ APPOINTMENTS COLLECTION ============
    match /appointments/{appointmentId} {
      // Clients can read their own appointments
      // Admins can read all appointments
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);

      // Client can create an appointment for themselves
      // Critical validations:
      // - Must be for themselves
      // - Cannot self-assign approved status
      // - Emergency fee MUST be 50 if isEmergency=true
      // - Emergency fee MUST be 0 if isEmergency=false
      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.status == 'pendiente'
        && request.resource.data.isEmergency is bool
        && (request.resource.data.isEmergency == true
              ? request.resource.data.extraFee == 50
              : request.resource.data.extraFee == 0)
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.serviceId is string;

      // Only admins can update appointments (accept/reject/reschedule/complete)
      allow update: if isAdmin();

      // Clients can cancel their own appointments while pending or accepted
      allow update: if isClient()
        && resource.data.clientId == request.auth.uid
        && resource.data.status in ['pendiente', 'aceptada']
        && request.resource.data.status == 'cancelada'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'updatedAt']);

      // Only admins can delete appointments
      allow delete: if isAdmin();
    }

    // ============ NOTIFICATIONS COLLECTION ============
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      // System (via Cloud Functions) or admin can create
      allow create: if isAdmin() || request.auth.token.admin == true;

      // Users can mark their own notifications as read
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readAt']);
    }

    // ============ DEFAULT RULE ============
    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
