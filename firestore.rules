rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isSuperAdmin() {
      return isSignedIn() && getUserRole() == 'superadmin';
    }

    function isBarber() {
      return isSignedIn() && getUserRole() == 'barber';
    }

    function isAdminOrBarber() {
      return isSuperAdmin() || isBarber();
    }

    // ============ USERS COLLECTION ============
    match /users/{userId} {
      // Own profile, superadmin, or same-role peers can read
      allow read: if isOwner(userId) || isSuperAdmin();

      // A user can create their own document during registration
      // Role MUST default to 'client'
      allow create: if isOwner(userId)
        && request.resource.data.role == 'client'
        && request.resource.data.email is string
        && request.resource.data.name is string;

      // A user can update their own profile BUT cannot change role
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'photoURL', 'updatedAt']);

      // Only superadmin can delete users
      allow delete: if isSuperAdmin();
    }

    // ============ BARBERS COLLECTION ============
    // Public read for the customer-facing barbers list and profiles
    match /barbers/{barberId} {
      allow read: if true;

      // Only superadmin can create barbers (via Cloud Function)
      allow create: if isSuperAdmin();

      // Superadmin can update any barber's fields
      // The barber themselves can update only their own profile fields
      allow update: if isSuperAdmin() ||
        (isBarber() && request.auth.uid == barberId &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['name', 'phone', 'photoURL', 'bio', 'specialties', 'yearsOfExperience', 'updatedAt']));

      // Only superadmin can delete barbers
      allow delete: if isSuperAdmin();
    }

    // ============ SERVICES COLLECTION ============
    match /services/{serviceId} {
      allow read: if true;

      allow create, update, delete: if isSuperAdmin();

      allow write: if isSuperAdmin()
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.durationMinutes is number
        && request.resource.data.durationMinutes > 0;
    }

    // ============ AVAILABILITY COLLECTION ============
    // Doc id format: {barberId}_{YYYY-MM-DD}
    match /availability/{availabilityId} {
      allow read: if true;

      // Superadmin OR the assigned barber can write
      allow create, update, delete: if isSuperAdmin() ||
        (isBarber() && (resource == null || resource.data.barberId == request.auth.uid));
    }

    // ============ APPOINTMENTS COLLECTION ============
    match /appointments/{appointmentId} {
      // Clients can read their own appointments
      // Superadmin can read all
      // Barbers can read only their own appointments
      allow read: if isSuperAdmin() ||
        (isSignedIn() && resource.data.clientId == request.auth.uid) ||
        (isBarber() && resource.data.barberId == request.auth.uid);

      // Client creates appointment for themselves
      allow create: if isSignedIn() && getUserRole() == 'client'
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.barberId is string
        && request.resource.data.status == 'pendiente'
        && request.resource.data.isEmergency is bool
        && (request.resource.data.isEmergency == true
              ? request.resource.data.extraFee == 50
              : request.resource.data.extraFee == 0)
        && request.resource.data.date is string
        && request.resource.data.time is string
        && request.resource.data.serviceId is string;

      // Superadmin or assigned barber can update status fields
      allow update: if isSuperAdmin() ||
        (isBarber() && resource.data.barberId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['status', 'updatedAt', 'aceptadaAt', 'rechazadaAt',
                     'completadaAt', 'reprogramadaAt', 'previousDate',
                     'previousTime', 'rescheduledBy', 'rescheduledAt',
                     'date', 'time']));

      // Clients can cancel their own appointments
      allow update: if isSignedIn()
        && resource.data.clientId == request.auth.uid
        && resource.data.status in ['pendiente', 'aceptada']
        && request.resource.data.status == 'cancelada'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'cancelledAt', 'updatedAt']);

      // Only superadmin can delete
      allow delete: if isSuperAdmin();
    }

    // ============ REVIEWS COLLECTION ============
    match /reviews/{reviewId} {
      // Public read for displaying barbers' ratings
      allow read: if true;

      // Reviews are created via Cloud Function (validates ownership)
      allow create: if false;

      // Reviews are immutable
      allow update, delete: if isSuperAdmin();
    }

    // ============ NOTIFICATIONS COLLECTION ============
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if request.auth.token.admin == true;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['read', 'readAt']);
    }

    // ============ DEFAULT ============
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
